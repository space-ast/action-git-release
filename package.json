{
  "name": "action-git-release",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action for creating releases on Gitee, GitCode and GitHub",
  "main": "lib/main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --minify",
    "build-debug": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --sourcemap --keep-names",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:gitee": "node scripts/smoke.mjs gitee",
    "smoke:gitcode": "node scripts/smoke.mjs gitcode",
    "fmt": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "fmtcheck": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-ast/action-git-release.git"
  },
  "keywords": [
    "actions",
    "gitee",
    "gitcode",
    "release"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "glob": "^13.0.6",
    "mime-types": "^3.0.2",
    "undici": "^8.11.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^4.0.4"
  }
}
